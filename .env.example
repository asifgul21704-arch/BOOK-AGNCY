# Port configuration (Dev container runs on port 3000)
PORT=3000
NODE_ENV=development

# Gemini API Key (Managed via AI Studio Secrets)
GEMINI_API_KEY=

# MongoDB URI (Optional if using MongoDB, defaults to high-speed file persistence)
MONGODB_URI=mongodb://localhost:27017/maktaba_haqanya

# JWT Secret for token signing
JWT_SECRET=maktaba_haqanya_super_secret_jwt_key_2026

# App URL
APP_URL=http://localhost:3000

# Cloudinary credentials for image storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email configuration (Optional Nodemailer)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=

# Payment Gateway (Stripe or Local Gateway)
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
